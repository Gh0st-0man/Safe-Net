{
  "name": "url-analyzer-extension",
  "displayName": "URL Analyzer",
  "version": "1.3.0",
  "description": "Analyze URLs for security threats and privacy concerns",
  "author": "Azan Moha",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@plasmohq/prettier-plugin-sort-imports": "^3.6.4",
    "@types/chrome": "^0.0.254",
    "@types/node": "^20.17.47",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
